  "_markers_comment": "Searched in every file's bytes, binaries included. A build must remap source paths (Rust --remap-path-prefix, Nuitka --file-reference-choice=runtime) so no build-machine path survives.",
  "deny_markers": [
    {
      "id": "home-path",
      "regex": "(?<![A-Za-z0-9_])/home/[A-Za-z_][A-Za-z0-9_.-]*/"
    },
    {
      "id": "macos-home-path",
      "regex": "(?<![A-Za-z0-9_])/Users/[A-Za-z_][A-Za-z0-9_.-]*/"
    },
    {
      "id": "windows-home-path",
      "regex": "(?i)[A-Z]:\\\\Users\\\\[A-Za-z_][A-Za-z0-9_.-]*\\\\"
    },
    {
      "id": "private-key",
      "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----"
    },
    {
      "id": "github-token",
      "regex": "\\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36}\\b|\\bgithub_pat_[A-Za-z0-9_]{60,}\\b"
    },
    {
      "id": "aws-key",
      "regex": "\\bAKIA[0-9A-Z]{16}\\b"
    },
    {
      "id": "slack-token",
      "regex": "\\bxox[abposr]-[A-Za-z0-9-]{10,}"
    },
    {
      "id": "source-map",
      "regex": "sourceMappingURL="
    },
    {
      "id": "python-source-header",
      "regex": "^#!/usr/bin/env python|^# -\\*- coding"
    }
  ],
  "_python_comment": "Byte signatures of Python source or bytecode hidden in an allowed file (a renamed .pyc, a zip appended to a binary). Magic numbers: 3.10 (6f 0d), 3.11 (a7 0d), 3.12 (cb 0d), 3.13 (f3 0d), each followed by \\r\\n.",
  "deny_bytecode_magic": [
    "6f0d0d0a",
    "a70d0d0a",
    "cb0d0d0a",
    "f30d0d0a"
  ],
  "max_file_count_growth": 0.25
}
